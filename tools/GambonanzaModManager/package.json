{
  "name": "gambonanza-mod-manager",
  "productName": "Gambonanza Mod Manager",
  "version": "1.5.0",
  "description": "Install Gambonanza mods with one click. Patches the game, keeps a backup, and keeps everything up to date.",
  "homepage": "https://bentrd.github.io/GambonanzaMods/",
  "author": {
    "name": "bentrd",
    "email": "benj.tordjman@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bentrd/GambonanzaMods.git",
    "directory": "tools/GambonanzaModManager"
  },
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/*.test.js\"",
