    "manager": {
      "tag": "manager-v1.0.3",
      "version": "1.0.3",
      "publishedAt": "2026-08-12T16:47:45Z",
      "notes": "\n- The mod list can no longer travel back in time: right after a release,\n  GitHub's CDN can briefly serve the previous registry index, which made\n  fresh mods flip back to \"coming soon\". The app now keeps the newest index\n  it has seen and falls back to a second source when a stale copy shows up.\n\n",
      "url": "https://github.com/bentrd/GambonanzaMods/releases/tag/manager-v1.0.3",
