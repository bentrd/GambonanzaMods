<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for RunTracker, the logic that decides when a run starts, is continued
    and is left. It has no game or Unity types, so this builds and runs anywhere:

        dotnet test sample_mods/StrainApi/Tests
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <RootNamespace>Gambonanza.StrainApi.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\RunTracker.cs" Link="RunTracker.cs" />
    <Compile Include="..\src\StrainBuilder.cs" Link="StrainBuilder.cs" />
    <Compile Include="..\src\StrainDefinition.cs" Link="StrainDefinition.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
